# Optional. Copy this file to .env and fill in the values you need.
# bench-audit reads .env from the current folder and from the repo root.
# The scripts in scripts/ source the repo root's .env.
# A variable that is already set in your shell is not replaced.

# ─── Auditor agent ────────────────────────────────────────────────────────────
# The default agent_cli is "claude" (the Claude Code command-line tool).
# Set a key here, or leave it empty and sign in with the `claude` command.
ANTHROPIC_API_KEY=


# ─── Common paths ─────────────────────────────────────────────────────────────
# Where benchmark repos + datasets live, referenced from configs/**/*.yaml as
# ${BENCHMARK_REPOS_DIR}/<name>/{repo,data}. Default: ./data/benchmark_repos
# BENCHMARK_REPOS_DIR=/absolute/path/to/benchmark_repos

# Where audit outputs land. Default: ./data/audit_runs
# AUDIT_RUN_DIR=/absolute/path/to/audit_runs


# ─── Optional ─────────────────────────────────────────────────────────────────
# Stream prompts + claude commands to stderr for debugging (0/1).
# BENCH_AUDIT_DEBUG_PROMPTS=0

# Batch static audit pipeline output dir (scripts/batch_static_audit_pipeline.sh).
# Defaults to ${REPO_ROOT}/data/multi_domain_all when unset.
# MULTI_DOMAIN_AUDIT_RUN_DIR=


# ─── Alternative agent backends ───────────────────────────────────────────────
# Only needed when overriding agent_cli to "codex" / "cursor" in a config,
# or when generating trajectories via Harbor.
# OPENAI_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=


# ─── Per-suite paths ──────────────────────────────────────────────────────────
# Only needed for the 9 configs that audit recorded runs, and for
# `bench-audit generate`. A config that uses one of these fails with a clear
# error when the variable is not set.
# HARBOR_DATASETS_DIR=        # configs/harbor/*.yaml and the tb2 / aider / gpqa / aime / dabstep run configs
# TB2_JOBS_DIR=               # configs/harbor/eval_claude_code_sonnet.yaml, code_swe/tb2_audit_config.yaml
# SWEBENCH_DIR=               # the swe_bench configs under configs/multi_domain_all/code_swe/


# ─── BenchGuard eval ──────────────────────────────────────────────────────────
# Only needed for benchmarks/benchguard/run_eval.sh (Gemini-based LLM judge).
# GEMINI_API_KEY=
# GOOGLE_API=                 # alias remapped to GEMINI_API_KEY by the script
# JUDGE_MODEL=gemini/gemini-3-flash-preview
# JUDGE_MAX_TOKENS=8192
